{
  "expo": {
    "name": "Tideglass",
    "slug": "mobile",
    "version": "1.0.0",
    "description": "A pocket-sized logic game about routing glowing currents through tide maps.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "splash": {
      "backgroundColor": "#081F25",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
